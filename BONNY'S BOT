# Example tick processor (simulate using tick inputs)
def tick_processor(ws_send_func):
    global tick_buffer, MODEL, FEATURE_COLS, open_trades, daily_loss, consecutive_losses
    while True:
        tick = tick_queue.get()
        price = float(tick['quote'])
        tick_buffer.append(price)
        if len(tick_buffer) > 200:
            tick_buffer.pop(0)
        # wait for minimum history
        if len(tick_buffer) < LOOKBACK + 2:
            continue
        # featurize and predict
        vec = featurize_from_buffer(tick_buffer[-(LOOKBACK+2):])  # ensure enough history
