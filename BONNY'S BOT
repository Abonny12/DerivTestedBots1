# --------------------
# UTIL: feature engineering
# --------------------
def load_ticks_csv(path):
    """
    Expect CSV: epoch,quote
    """
    df = pd.read_csv(path)
    df = df.sort_values("epoch").reset_index(drop=True)
    return df

def engineer_features(df, lookback=10):
    """
    Create features for each tick: returns, moving averages, momentum, volatility, last N deltas
    We'll produce a dataset where label = price change after DURATION ticks (direction).
    """
    df = df.copy()
    df['quote'] = df['quote'].astype(float)
    df['ret1'] = df['quote'].pct_change().fillna(0)
    df['ma5'] = df['quote'].rolling(window=5, min_periods=1).mean()
    df['ma10'] = df['quote'].rolling(window=10, min_periods=1).mean()
    df['std5'] = df['quote'].rolling(window=5, min_periods=1).std().fillna(0)
    # last N deltas
    for i in range(1, lookback+1):
        df[f'delta_{i}'] = df['quote'].diff(i).fillna(0)
    # drop early rows if needed
    df = df.reset_index(drop=True)
    return df

def build_dataset(df, duration_ticks=5, lookback=10):
    """
    For each row t, label is whether price at t+duration > price at t (CALL) or < (PUT)
    Returns X, y aligned (drops tail where forward price unknown)
    """
    df_feat = engineer_features(df, lookback=lookback)
    df_feat['future_quote'] = df_feat['quote'].shift(-duration_ticks)
    df_feat = df_feat.dropna(subset=['future_quote']).reset_index(drop=True)
    # label: 1 = CALL (over), 0 = PUT (under), ties => 0 (PUT)
    df_feat['label'] = (df_feat['future_quote'] > df_feat['quote']).astype(int)
    feature_cols = ['ret1', 'ma5', 'ma10', 'std5'] + [f'delta_{i}' for i in range(1, lookback+1)]
    X = df_feat[feature_cols].values
    y = df_feat['label'].values
    return X, y, feature_cols

# --------------------
# MODEL: train & save
# --------------------
def train_and_save_model(csv_path, model_path=MODEL_PATH):
    df = load_ticks_csv(csv_path)
    X, y, feature_cols = build_dataset(df)
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=TRAIN_TEST_SPLIT, random_state=RANDOM_SEED, stratify=y)
    clf = RandomForestClassifier(n_estimators=200, max_depth=8, random_state=RANDOM_SEED, n_jobs=-1)
    clf.fit(X_train, y_train)
    acc_train = clf.score(X_train, y_train)
    acc_test = clf.score(X_test, y_test)
    joblib.dump({'model': clf, 'features': feature_cols}, model_path)
    print(f"Trained RF. train_acc={acc_train:.4f}, test_acc={acc_test:.4f}. Saved to {model_path}")
    return clf, feature_cols

# --------------------
# BACKTESTER (simple)
# --------------------
def backtest(csv_path, model_path=MODEL_PATH, stake=STAKE, duration=DURATION):
    if not os.path.exists(model_path):
        print("Model not found. Train first.")
        return
    mm = joblib.load(model_path)
    clf = mm['model']
    features = mm['features']

    df = load_ticks_csv(csv_path)
    X, y, _ = build_dataset(df, duration_ticks=duration)
    preds_proba = clf.predict_proba(X)[:,1]  # probability of CALL
    preds = (preds_proba > 0.53).astype(int)  # threshold; tuneable

    # simple P/L assumptions: if prediction==label => win, payout approximate 0.8*stake (example)
    payout_ratio = 0.8  # placeholder; actual depends on contract payout
    balance = 0.0
    wins = losses = 0
    for i, pred in enumerate(preds):
        actual = y[i]
        if pred == actual:
            profit = payout_ratio * stake
            balance += profit
            wins += 1
        else:
            balance -= stake
            losses += 1
    total = wins + losses
    win_rate = wins/total if total>0 else 0
    print(f"Backtest result: balance={balance:.2f}, win_rate={win_rate:.3f}, trades={total}, wins={wins}, losses={losses}")
    return {'balance': balance, 'win_rate': win_rate, 'trades': total}

