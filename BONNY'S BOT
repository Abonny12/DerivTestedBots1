MODEL, FEATURE_COLS = None, None

def featurize_from_buffer(buffer):
    """
    buffer: list of recent quotes (floats), newest last
    produce feature vector consistent with training
    """
    s = pd.Series(buffer)
    quote = s.iat[-1]
    ret1 = (s.iat[-1] - s.iat[-2]) / s.iat[-2] if len(s)>=2 and s.iat[-2]!=0 else 0.0
    ma5 = s.tail(5).mean()
    ma10 = s.tail(10).mean()
    std5 = s.tail(5).std() if len(s)>=5 else 0.0
    deltas = []
    for i in range(1, LOOKBACK+1):
        if len(s) > i:
            deltas.append(quote - s.iat[-1-i])
        else:
            deltas.append(0.0)
    vec = [ret1, ma5, ma10, std5] + deltas
    return np.array(vec).reshape(1,-1)

def allowed_to_trade():
    global daily_loss, open_trades, consecutive_losses
    if len(open_trades) >= MAX_CONCURRENT:
        return False, "max concurrent reached"
    if daily_loss <= -MAX_DAILY_LOSS:
        return False, "daily loss limit reached"
    if consecutive_losses >= COOLDOWN_AFTER_LOSS_TRADES:
        return False, "cooldown due to losses"
    return True, ""

def place_trade_decision(prob_call, stake=STAKE):
    """
    Decide: if prob_call > thresh => BUY CALL, if prob_call < 1-thresh => BUY PUT, else skip
    """
    thresh = 0.56
    if prob_call >= thresh:
        return "CALL"
    if prob_call <= (1-thresh):
        return "PUT"
    return None

